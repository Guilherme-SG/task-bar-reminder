{
  "testCommand": "npx jest --json",
  "reporter": "jest-json",
  "testGlobs": [
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**"
  ],
  "srcGlobs": [
    "src/main.js",
    "src/core/ConfigLoader.js",
    "src/core/AudioPlayer.js",
    "src/core/ReminderService.js",
    "src/ui/ManageRemindersWindow.js",
    "src/ui/manage-reminders.html",
    "src/ui/ReminderWindow.js",
    "src/ui/Tray.js"
  ]
}
